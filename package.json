{
  "name": "multi-ai-terminal",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build -w @mat/shared && concurrently -k -n server,web -c blue,magenta \"npm run dev -w @mat/server\" \"npm run dev -w @mat/web\"",
    "build": "npm run build -w @mat/shared && npm run build -w @mat/server && npm run build -w @mat/web",
    "desktop:bundle": "node scripts/bundle-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:bundle && cd desktop/src-tauri && npx tauri build",
    "desktop:dev": "npm run build && npm run desktop:bundle && cd desktop/src-tauri && npx tauri dev",
    "evidence": "node tools/evidence/run-all.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "agent:audit": "node scripts/agent/audit.mjs",
    "agent:launch": "node scripts/agent/launch.mjs",
    "agent:status": "node scripts/agent/status.mjs",
    "agent:stop": "node scripts/agent/stop.mjs",
    "sync:runtime-catalog": "node scripts/sync-runtime-catalog.mjs",
    "test": "vitest run",
    "test:agent": "vitest run scripts/agent/tests",
    "test:runtime-catalog": "vitest run tests/runtime-catalog-sync.test.mjs",
    "start": "node server/dist/index.js",
    "typecheck": "npm run typecheck -w @mat/shared && npm run typecheck -w @mat/server && npm run typecheck -w @mat/web",
    "verify:version": "node scripts/verify-version.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@openai/codex": "0.144.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "zod": "^3.25.76"
  }
}
