{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-AI Terminal",
  "version": "0.2.6",
  "identifier": "com.ted-h.multi-ai-terminal",
  "mainBinaryName": "multi-ai-terminal",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/server": "server",
      "../resources/web": "web"
    },
    "category": "DeveloperTool",
    "shortDescription": "A desktop workbench for multi-agent coding workflows.",
    "longDescription": "Multi-AI Terminal runs headless CLI coding agents through a local workflow orchestration server and presents their work in a desktop webview."
  }
}
